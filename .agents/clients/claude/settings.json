{
  "model": "claude-fable-5-1[1m]",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": { "effortLevel": "medium" },
    "claude-fable-5-1": { "effortLevel": "high" },
    "claude-sonnet-5": { "effortLevel": "low" }
  },
  "outputStyle": "Concise",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "MAX_MCP_OUTPUT_TOKENS": "10000"
  },
  "bashOutputMaxChars": 20000,
  "autoCompactWindow": 300000,
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h",
  "skillOverrides": {
    "3d-models": "collapsed",
    "agent-engineering": "collapsed",
    "agy-image-babysitter": "collapsed",
    "backend-systems": "collapsed",
    "cloud-devops": "collapsed",
    "code-review": "collapsed",
    "data-engineering": "collapsed",
    "documentation": "collapsed",
    "finishing-dev": "collapsed",
    "frontend-engineering": "collapsed",
    "git-workflow": "collapsed",
    "goldsrc-modding": "collapsed",
    "mobile-engineering": "collapsed",
    "observability": "collapsed",
    "performance-engineering": "collapsed",
    "radar-ia": "collapsed",
    "security-ops": "collapsed",
    "software-architecture": "collapsed",
    "starting-dev": "collapsed",
    "test-engineering": "collapsed",
    "threejs": "collapsed",
    "tooling-dev": "collapsed",
    "web-research": "collapsed"
  },
  "enableWorkflows": true,
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "telegram@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "autoContinueAtUsageLimit": true,
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
