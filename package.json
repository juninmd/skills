{
  "name": "padrao-labs-agents-root",
  "version": "1.44.0",
  "private": true,
  "publisher": "luizalabs",
  "description": "Luizalabs Agents, Skills, Rules, and Workflows",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "AI",
    "Education"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm -r run dev",
    "prebuild": "pnpm run gen:marketplace && pnpm run lint:plugins && pnpm run lint:agents && pnpm run lint:skills",
    "build": "pnpm -r run build",
    "start": "pnpm -r run start",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules --ignore docs --ignore .",
    "lint:md:fix": "markdownlint '**/*.md' --ignore node_modules --ignore docs --ignore . --fix",
    "lint:skills": "node scripts/lint-skills.mjs",
    "lint:agents": "node scripts/lint-agents.mjs",
    "lint:plugins": "node scripts/lint-plugins.mjs",
    "gen:marketplace": "node scripts/generate-marketplace.mjs",
    "test": "pnpm -r run test",
    "test:run": "pnpm -r run test:run",
    "test:ui": "pnpm -r run test:ui",
    "test:coverage": "pnpm -r run test:coverage",
    "lint": "pnpm run lint:md && pnpm run lint:skills && pnpm run lint:agents && pnpm run lint:plugins"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "chokidar": "^3.6.0",
    "gray-matter": "^4.0.3",
    "markdownlint-cli": "^0.47.0",
    "vitest": "^4.0.18",
    "zod": "^4.3.6"
  }
}
