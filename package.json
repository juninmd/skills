{
  "name": "juninmd-skills",
  "version": "1.0.0",
  "description": "Skills, agents, prompts and rules for AI coding assistants",
  "scripts": {
    "plugin:validate": "node .agents/tools/validate-plugin.mjs",
    "agents:validate": "node .agents/tools/validate-agents.mjs .agents",
    "evals:generate": "node .agents/tools/generate-evals.mjs .agents",
    "evals:validate": "node .agents/tools/validate-evals.mjs .agents",
    "catalog:check": "node .agents/tools/check-catalog.mjs",
    "pr:check": "node .agents/tools/pr-skill-checks.mjs",
    "test:validators": "node --test .agents/tools/*.test.mjs",
    "validate": "pnpm run plugin:validate && pnpm run agents:validate && pnpm run evals:validate && pnpm run catalog:check && pnpm run test:validators",
    "docs:dev": "npx vitepress dev docs",
    "docs:build": "npx vitepress build docs",
    "docs:preview": "npx vitepress preview docs"
  },
  "devDependencies": {
    "vitepress": "^1.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
