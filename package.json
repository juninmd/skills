{
  "name": "padrao-labs-agents-docs",
  "version": "1.0.0",
  "description": "VitePress documentation for Luizalabs Agents, Skills, Rules, and Workflows",
  "type": "module",
  "scripts": {
    "docs:dev": "node src/loader.js && vitepress dev docs",
    "docs:build": "node src/loader.js && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "generate:index": "node src/loader.js",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules --ignore docs",
    "lint:md:fix": "markdownlint '**/*.md' --ignore node_modules --ignore docs --fix",
    "start": "node server.js"
  },
  "dependencies": {
    "minisearch": "^6.2.0",
    "vitepress": "^1.5.0",
    "vitepress-mermaid-preview": "^0.1.1",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "chokidar": "^3.6.0",
    "markdownlint-cli": "^0.47.0",
    "vite": "^5.0.0"
  }
}
